# Copy to .env and edit. Defaults run fully offline in mock mode.
MODEL_MODE=mock                         # mock | replay | live
MODEL_BASE_URL=http://localhost:8000/v1 # vLLM endpoint (port-forwarded from the pod)
MODEL_NAME=Qwen3-4B                      # swap to your 70B served-model-name for the demo
MODEL_API_KEY=abc-123
FIXTURES_DIR=fixtures                    # replay mode reads here; capture_fixtures.py writes here


