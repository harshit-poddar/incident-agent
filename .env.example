# Copy to .env and edit. Defaults run fully offline in mock mode.
MODEL_MODE=live                       # mock | replay | live
MODEL_BASE_URL=https://unbigamous-orion-briery.ngrok-free.dev/v1 # vLLM endpoint (port-forwarded from the pod)
MODEL_NAME=incident-llm                      # swap to your 70B served-model-name for the demo
MODEL_API_KEY=abc-123
FIXTURES_DIR=fixtures                    # replay mode reads here; capture_fixtures.py writes here

# Incident persistence (async approval gate). memory = in-process dict (no deps).
# postgres = durable, survives restarts (needs the postgres service up).
STORE_MODE=memory                        # memory | postgres
DATABASE_URL=postgresql://agent:agent@localhost:5432/incidents

# RAG over runbooks. RAG_MODE picks the vector store; EMBED_MODE picks the
# embedder (mock = offline hash, no GPU; live = served embedding model).
# EMBED_DIM must match the qdrant collection and (in live mode) the model dim.
RAG_MODE=memory                          # memory | qdrant
EMBED_MODE=mock                          # mock | live
EMBED_DIM=256
EMBED_MODEL_NAME=bge-small-en
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=runbooks

# Telemetry. TELEMETRY_MODE picks the service-metrics source; GPU_MONITOR_MODE
# picks the MI300X self-monitor (rocm = shell out to rocm-smi on the pod).
TELEMETRY_MODE=mock                       # mock | redis
GPU_MONITOR_MODE=mock                     # mock | rocm
REDIS_URL=redis://localhost:6379/0

# GitHub integration. mock = offline canned data (POST /github/simulate drives
# the whole flow with no network). live = real REST API: the agent pulls failed
# CI logs and, after approval, opens a real fix PR.
GITHUB_MODE=mock                          # mock | live
GITHUB_TOKEN=                             # PAT with repo + workflow scope (live only)
GITHUB_REPO=harshit-poddar/incident-agent # owner/name the agent acts on
GITHUB_BASE_BRANCH=main                   # PRs target this branch
GITHUB_WEBHOOK_SECRET=                     # set this and GitHub's webhook secret to match
GITHUB_TARGET_FILE=payments/handler.py    # the file the Fixer reads and patches

# Java vulnerability fixer. A SEPARATE fine-tuned model -- a LoRA adapter
# ("vuln-fixer") on Qwen2.5-Coder-7B served via vLLM --enable-lora behind its
# own OpenAI-compatible endpoint. mock = offline canned secure rewrite (no GPU);
# live = hit the endpoint. The orchestrator passes the CWE explicitly for now.
VULN_FIXER_MODE=mock                      # mock | live
VULN_FIXER_BASE_URL=http://localhost:8000/v1  # the pod's vuln-fixer endpoint
VULN_FIXER_MODEL_NAME=vuln-fixer          # served LoRA adapter name
VULN_FIXER_API_KEY=none                   # not required by the endpoint
VULN_DEMO_FILE=src/main/java/com/acme/payments/PaymentRepository.java
VULN_DEMO_CWE=CWE-89                       # CWE-89 | CWE-78 | CWE-22

# Observability (tracing across the agent graph). memory = in-process tracer
# that powers the dashboard waterfall (no deps). otel = also export the same
# spans to OpenTelemetry (needs opentelemetry-sdk; empty OTEL_ENDPOINT = console
# exporter, else an OTLP gRPC endpoint like localhost:4317).
TRACE_MODE=memory                         # memory | otel
OTEL_ENDPOINT=                            # OTLP gRPC endpoint; empty = console
OTEL_SERVICE_NAME=agents-026-incident-agent
